{
  "name": "@wingbrace/glideslope-icons",
  "version": "0.0.0",
  "description": "Glideslope icon set as tree-shakeable Vue 3 components.",
  "type": "module",
  "license": "Apache-2.0",
  "keywords": [
    "icons",
    "vue",
    "glideslope"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/icons/*.d.ts",
      "default": "./dist/icons/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/svg"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "vp build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vp test run"
  },
  "peerDependencies": {
    "vue": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vue/test-utils": "catalog:",
    "jsdom": "catalog:",
    "svgo": "catalog:",
    "typescript": "catalog:",
    "vue": "catalog:",
    "vite-plus": "catalog:"
  }
}
