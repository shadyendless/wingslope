{
  "color-mono-muted": "[data-color=\"mono-muted\"]",
  "color-mono-bold": "[data-color=\"mono-bold\"]",
  "color-accent": "[data-color=\"accent\"]",
  "color-info": "[data-color=\"info\"]",
  "color-advisory": "[data-color=\"advisory\"]",
  "color-normal": "[data-color=\"normal\"]",
  "color-serious": "[data-color=\"serious\"]",
  "color-critical": "[data-color=\"critical\"]",

  "size-xlarge": "[data-size=\"xlarge\"]",
  "size-large": "[data-size=\"large\"]",
  "size-medium": "[data-size=\"medium\"]",
  "size-small": "[data-size=\"small\"]",
  "size-xsmall": "[data-size=\"xsmall\"]",

  "elevation-raised": "[data-elevation=\"raised\"]",
  "elevation-overlay": "[data-elevation=\"overlay\"]",

  "layout-grid": "[data-layout=\"grid\"]",
  "layout-stack": "[data-layout=\"stack\"]",
  "layout-inline": "[data-layout=\"inline\"]",

  "orientation-horizontal": "[data-orientation=\"horizontal\"]",
  "orientation-vertical": "[data-orientation=\"vertical\"]",

  "side-top": "[data-side=\"top\"]",
  "side-right": "[data-side=\"right\"]",
  "side-bottom": "[data-side=\"bottom\"]",
  "side-left": "[data-side=\"left\"]",

  "align-start": "[data-align=\"start\"]",
  "align-center": "[data-align=\"center\"]",
  "align-end": "[data-align=\"end\"]",

  "enabled": ":not(:disabled, [data-disabled])",

  "open": "[data-state=\"open\"], [open], :popover-open",
  "closed": "[data-state=\"closed\"]",
  "expanded": "[aria-expanded=\"true\"], [data-expanded]",

  "placeholder-shown": ":placeholder-shown, [data-placeholder]",

  "current": "[aria-current]:not([aria-current=\"false\"])",

  "required": ":required, [aria-required=\"true\"]",
  "invalid": ":user-invalid, [aria-invalid=\"true\"], [data-invalid]",
  "read-only": "[readonly], [aria-readonly=\"true\"], [data-readonly]",

  "empty": ":empty",

  "focus-within": ":focus-within",
  "focus-visible-within": ":has(:focus-visible)",

  "hover": { "media": "(hover: hover)", "selector": ":hover" },
  "focus": ":focus",
  "focus-visible": ":focus-visible",
  "active": ":active",

  "highlighted": "[data-highlighted]",

  "checked": ":checked, [data-state=\"checked\"]",
  "indeterminate": ":indeterminate, [data-state=\"indeterminate\"]",
  "selected": ":checked, [data-state=\"checked\"], [data-state=\"on\"], [data-state=\"active\"], [data-selected], [aria-selected=\"true\"], [aria-pressed=\"true\"]",

  "disabled": ":disabled, [data-disabled], [aria-disabled=\"true\"]",

  "dark": ".dark, .dark *, [data-theme=\"dark\"], [data-theme=\"dark\"] *",
  "light": ".light, .light *, [data-theme=\"light\"], [data-theme=\"light\"] *"
}
